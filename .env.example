# Use "fixture" only for local development, or "supabase" for production adapters.
VITE_DATA_ADAPTER=fixture
# Browser-safe public values only. Never add service_role or private credentials here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public VAPID key only. VAPID_SUBJECT and VAPID_PRIVATE_KEY belong in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=
